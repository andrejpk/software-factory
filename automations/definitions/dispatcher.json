{
  "name": "sf-dispatcher",
  "description": "Promotes tasks whose dependencies merged and hands ready tasks to the implementer by label (sf:in-progress), WIP limit 2.",
  "type": "personal",
  "prompt_files": [
    "_conventions.md",
    "dispatcher.md"
  ],
  "run_limit_credits": 30,
  "daily_limit_credits": 60,
  "tools": [
    "github/issue_read",
    "github/list_issues",
    "github/search_issues",
    "github/update_issue_labels",
    "github/add_issue_comment",
    "github/search_pull_requests",
    "github/list_pull_requests",
    "github/update_issue_state",
    "github/pull_request_read"
  ],
  "triggers": {
    "issue_opened": {
      "write_scope": "repository",
      "allow_copilot_triggers": true,
      "query": "label:sf:task"
    },
    "issue_closed": {
      "write_scope": "repository",
      "allow_copilot_triggers": true,
      "query": "label:sf:task"
    },
    "issue_labeled": {
      "labels": [
        "sf:task"
      ],
      "write_scope": "repository"
    },
    "interval": {
      "cadence": [
        "hourly"
      ]
    }
  }
}
