# Software Factory configuration. Copy to .env and fill in values.
# Foundry authentication uses Microsoft Entra ID: run `az login --tenant <tenant-id>` first.

# Foundry (required)
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=
AZURE_TENANT_ID=
AZURE_TOKEN_CREDENTIALS=dev

# Optional
SOFTWARE_FACTORY_AGENT_NAME=software-factory-lead
SOFTWARE_FACTORY_HOME=
LOG_LEVEL=INFO

# First test project (development and live tests only).
# Use a disposable, EMPTY repository owned by your personal account.
# Classic PAT with the `repo` and `project` scopes.
SF_TEST_REPO_URL=https://github.com/<your-user>/<empty-repo>
SF_TEST_GITHUB_PAT=
